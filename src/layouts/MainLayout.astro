---
// Main site layout - includes header navigation and content slot
import '@/styles/global.css';
import NavigationBar from '@/components/NavigationBar.astro';
import CategoryList from '@/components/CategoryList.astro';
import TagList from '@/components/TagList.astro';
import ArchiveList from '@/components/ArchiveList.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { SITE_DESCRIPTION } from '@/consts';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const buildAppSha = process.env.APP_SHA || 'local';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="build-app-sha" content={buildAppSha} />
  <meta name="keywords" content="Astro, 博, 技术, 文章" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#ffffff">
    <script is:inline src="/registerSW.js" defer data-swup-ignore-script></script>
    <link
      rel="preload"
      as="image"
      href="/images/head-768.webp"
      imagesrcset="/images/head-768.webp 768w, /images/head-1536.webp 1536w"
      imagesizes="100vw"
    >
    <link
      rel="preload"
      as="image"
      href="/images/wallpaper-1280.webp"
      imagesrcset="/images/wallpaper-1280.webp 1280w, /images/wallpaper-2560.webp 2560w"
      imagesizes="100vw"
    >
    <link rel="preload" as="image" href="/avatar.webp" media="(min-width: 768px)">
  </head>
  <body>
    <TableOfContents />
    <div class="content-wrapper">
      <div class="mx-auto md:my-[21px] max-w-[1152px] relative">
        <div id="header-container">
          <div class="header-placeholder relative md:rounded-t-xl">
            <header></header>
          </div>
          <NavigationBar />
        </div>

        <div id="main-content" class="shadow-soft-lg overflow-hidden flex flex-col md:flex-row" style="background-color: var(--main-content-bg);">
          <main id="swup" class="swup-transition-fade w-full md:w-3/4">
            <div class="p-4 md:p-8">
              <slot />
            </div>
          </main>

          <aside id="sidebar" class="w-full md:w-1/4 p-4 md:pt-24 space-y-8" style="box-shadow: var(--divider-box-shadow);">
            <CategoryList />
            <TagList />
            <ArchiveList />
          </aside>
        </div>

        <footer id="footer" class="h-[39px] p-4 flex items-center justify-end md:rounded-b-xl" style="background-color: var(--footer-bg); border-top: 1px solid var(--divider-shadow-strong);">
          <p class="text-sm">
            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="font-light text-text-primary footer-link">Self-designed, Astro-driven.</a>
          </p>
        </footer>
        
        <img
          id="avatar"
          src="/avatar.webp"
          alt="Avatar"
          width="96"
          height="96"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-swup-preserve="avatar"
          class="hidden md:block absolute top-[468px] left-3/4 -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full border-4 border-white shadow-soft-lg z-10"
        />
      </div>
    </div>
    <script>
      import { startClientRuntime } from '@/client/runtime';
      startClientRuntime();
    </script>
  </body>
</html>
