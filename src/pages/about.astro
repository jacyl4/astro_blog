---
import { render } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';
import { getPageById } from '@/modules/pages';

const about = await getPageById('about');
const { Content } = await render(about);
---

<MainLayout title={`${about.data.title} - ${SITE_TITLE}`}>
  <h1 class="text-3xl font-bold mb-8">{about.data.title}</h1>
  <article class="prose prose-invert max-w-none">
    <Content />
  </article>
</MainLayout>
