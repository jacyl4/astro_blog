---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import {
  getArchiveMonths,
  getPostsByArchiveMonth,
  type ProcessedBlogPost,
} from '@/modules/blog';

export async function getStaticPaths() {
  const months = await getArchiveMonths();
  return Promise.all(months.map(async (yearMonth) => ({
      params: { year_month: yearMonth },
      props: {
        posts: await getPostsByArchiveMonth(yearMonth),
        yearMonth,
      },
    })));
}

interface Props {
  posts: ProcessedBlogPost[];
  yearMonth: string;
}

const { posts, yearMonth } = Astro.props;
import { SITE_TITLE, UI_TEXT } from '../../consts';
---

<MainLayout title={`${UI_TEXT.archiveTitle}: ${yearMonth} - ${SITE_TITLE}`}>
  <h1 class="text-3xl font-bold mb-8">{UI_TEXT.archiveTitle}: {yearMonth}</h1>
  <p class="mb-8" style="color: var(--meta-date-color);">
    {UI_TEXT.postsInYearMonth(posts.length, yearMonth)}
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => (
      <BlogPostCard post={post} />
    ))}
  </div>
</MainLayout>
