---
import { render } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { getPageById } from '@/modules/pages';

const notFoundPage = await getPageById('not-found');
const { Content } = await render(notFoundPage);
---
<MainLayout title={notFoundPage.data.title}>
  <article class="prose prose-invert max-w-none text-center">
    <h1 class="text-6xl font-bold">404</h1>
    <Content />
  </article>
</MainLayout>
