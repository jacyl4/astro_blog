{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "<blog-worker-name>",
  "compatibility_date": "<set-to-current-reviewed-date>",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "name": "<blog-worker-name>-staging"
    },
    "production": {
      "name": "<blog-worker-name>"
    }
  }
}
