{
  "name": "astro_blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run content:prepare && astro dev",
    "build": "npm run content:prepare && npm run build:prepared",
    "build:prepared": "astro check && astro build",
    "build:ci": "astro build",
    "check": "npm run content:prepare && npm run check:prepared",
    "check:prepared": "astro check && npm run test:unit",
    "preview": "astro preview",
    "astro": "astro",
    "serve": "cd dist && python3 -m http.server 8080",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:staging": "playwright test",
    "test:routes-http": "playwright test tests/browser/routes-http.spec.ts",
    "smoke:static": "tsx tools/release/smoke-static.ts",
    "routes:generate": "tsx tools/release/generate-route-manifest.ts",
    "routes:verify": "tsx tools/release/verify-route-manifest.ts",
    "html-baseline:generate": "tsx tools/release/generate-html-baseline.ts",
    "html-baseline:verify": "tsx tools/release/verify-html-baseline.ts",
    "assets:generate": "tsx tools/release/generate-asset-manifest.ts",
    "assets:verify": "tsx tools/release/verify-assets.ts",
    "manifest:build": "tsx tools/release/generate-build-manifest.ts",
    "comments:verify-removed": "tsx tools/release/comments-zero-residue.ts",
    "boundaries:verify": "tsx tools/quality/verify-module-boundaries.ts",
    "paths:verify": "tsx tools/quality/verify-portable-paths.ts",
    "evidence:privacy": "tsx tools/quality/verify-evidence-privacy.ts",
    "performance:collect": "tsx tools/quality/collect-web-performance.ts",
    "faults:verify": "bash tools/quality/fault-injection.sh",
    "cloudflare:verify-static": "tsx tools/quality/verify-cloudflare-static.ts",
    "ci:verify": "tsx tools/quality/verify-ci-contract.ts",
    "openspec:validate": "openspec validate --all --strict",
    "openspec:evidence": "tsx tools/quality/openspec-evidence-matrix.ts",
    "openspec:evidence:check": "tsx tools/quality/openspec-evidence-matrix.ts --check",
    "http:sweep": "tsx tools/release/http-sweep.ts",
    "deployment:wait": "tsx tools/release/wait-for-deployment.ts",
    "content:inventory": "tsx tools/content-compiler/index.ts inventory",
    "content:validate": "tsx tools/content-compiler/index.ts validate",
    "content:compile": "tsx tools/content-compiler/index.ts compile",
    "content:prepare": "bash tools/ci/prepare-content.sh",
    "content:measure": "tsx tools/quality/measure-content-compile.ts",
    "content:migrate": "tsx tools/content-compiler/apply-migration.ts",
    "verify:dist": "npm run routes:verify && npm run html-baseline:verify && npm run smoke:static && npm run assets:verify && npm run comments:verify-removed && npm run faults:verify && npm run routes:generate && npm run assets:generate && npm run manifest:build",
    "verify": "npm run content:prepare && npm run check:prepared && npm run boundaries:verify && npm run paths:verify && npm run evidence:privacy && npm run comments:verify-removed && npm run cloudflare:verify-static && npm run ci:verify && npm run cf:types:check && npm run openspec:evidence:check && npm run build:prepared && npm run verify:dist",
    "verify:full": "npm run verify && npm run test:browser",
    "cf:types": "wrangler types worker-configuration.d.ts --env staging",
    "cf:types:check": "wrangler types worker-configuration.d.ts --env staging --check",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .build/wrangler-dry-run",
    "cf:deploy:staging": "wrangler deploy --env staging --strict",
    "cf:deploy:production": "wrangler deploy --env production --strict"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@iconify-json/lucide": "^1.2.64",
    "@swup/astro": "^1.7.0",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "7.1.5",
    "astro-icon": "^1.1.5",
    "hast-util-sanitize": "^5.0.2",
    "katex": "^0.16.22",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-unwrap-images": "^4.0.1",
    "remark-wiki-link": "^2.0.1",
    "swup": "^4.8.2",
    "swup-morph-plugin": "1.3.0",
    "tailwindcss": "^4.1.12",
    "transliteration": "^2.3.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.5.0",
    "@playwright/test": "^1.62.0",
    "@types/estree": "^1.0.8",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/nlcst": "^2.0.3",
    "@types/node": "^24.3.0",
    "@types/unist": "^3.0.3",
    "autoprefixer": "^10.4.21",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "vitest": "^4.1.6",
    "wrangler": "4.114.0",
    "yaml": "^2.9.0"
  }
}
